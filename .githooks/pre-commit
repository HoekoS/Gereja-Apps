#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
staged=$(git diff --cached --name-only --diff-filter=ACMR)

markdown=$(printf '%s\n' "$staged" | grep -E '^(api|app)/.*\.md$' || true)
if [ -n "$markdown" ]; then
  echo "Markdown is not allowed under api/ or app/ (see AGENTS.md):"
  echo "$markdown"
  exit 1
fi

if printf '%s\n' "$staged" | grep -qE '^api/.*\.go$'; then
  if command -v gofmt >/dev/null 2>&1; then
    unformatted=$(gofmt -l api)
    if [ -n "$unformatted" ]; then
      echo "Unformatted Go files:"; echo "$unformatted"; echo "Fix with: gofmt -w api"; exit 1
    fi
  else
    echo "gofmt not found; skipping (CI still checks it)."
  fi
fi
