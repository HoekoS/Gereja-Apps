meta {
  name: setup add a song item back to the service
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/services/{{serviceId}}/items
  body: json
  auth: none
}

body:json {
  {
    "kind": "song",
    "label": "Lagu Respon",
    "ref": { "songId": "{{songId}}" }
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("liveSongItemId", res.getBody().id);
}

tests {
  test("setup: the service has a song item to run", function() {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  Not a test. 06-services ends by deleting its song item, so this folder puts
  one back. After this the service holds the Bible item at position 0 and this
  song at position 1.
}
