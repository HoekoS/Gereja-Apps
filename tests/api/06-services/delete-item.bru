meta {
  name: SYS-SVC-05 remove an item from the order
  type: http
  seq: 7
}

delete {
  url: {{baseUrl}}/api/services/{{serviceId}}/items/{{songItemId}}
  body: none
  auth: none
}

assert {
  res.status: eq 204
}

tests {
  test("SYS-SVC-05: a delete answers 204 with no body", function() {
    expect(res.getStatus()).to.equal(204);
    expect(res.getBody()).to.satisfy(b => b === undefined || b === null || b === "");
  });
}

docs {
  Traces FR-SVC-06, URS-PREP-05. The order after the delete is checked by
  order-after-delete.bru, because a 204 carries no body to check it in.
}
