meta {
  name: SYS-SVC-04 an incomplete reorder is rejected
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/services/{{serviceId}}/items/reorder
  body: json
  auth: none
}

body:json {
  {
    "itemIds": ["{{songItemId}}"]
  }
}

assert {
  res.status: eq 400
}

tests {
  test("SYS-SVC-04: a partial id list is refused", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error.code).to.equal("INCOMPLETE_ORDER");
  });
}

docs {
  Traces FR-SVC-05. The order list must name every item in the service. A
  partial list is ambiguous about where the missing items go, and silently
  dropping them would delete part of the service order. Refuse instead.
}
